FINDWORK_API_KEY=api_key

# Database credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobscan
SPRING_DATASOURCE_USERNAME=jobscan
SPRING_DATASOURCE_PASSWORD=jobscan

# Cognito user pool that issues the API's access tokens (outputs of ../jobscan-backoffice/terraform)
COGNITO_ISSUER_URI=https://cognito-idp.eu-west-1.amazonaws.com/<user pool id>
COGNITO_SPA_CLIENT_ID=<spa app client id>
